@startuml
!theme plain

skinparam nodesep 10
skinparam ranksep 20

actor User
participant "Chat UI" as UI
participant "API Layer" as API
participant "Agent Controller" as BL
participant "LLM Agent" as LLM
participant "Retrieval Tool" as TOOL
participant "Embedder" as EMB
database "PostgreSQL\n+ pgvector" as DB

User -> UI: Submit Query
activate UI

UI -> API: POST /help\n{prompt, sessionToken}
activate API

API -> API: Validate Session

API -> BL: Process Query(prompt, userKey)
activate BL

BL -> BL: Load Chat History
BL -> BL: Construct Agent:\n- System Instructions\n- Tool Definitions\n- Conversation History

BL -> LLM: Stream Agent Execution\n(messages, tools)
activate LLM

LLM -> LLM: Reason: Does query\nneed retrieval?

alt Tool Invocation Needed
    LLM -> TOOL: Invoke plm_documentation_retriever\n(refined query)
    activate TOOL
    
    TOOL -> EMB: Generate Embedding(query)
    activate EMB
    EMB --> TOOL: Embedding Vector
    deactivate EMB
    
    TOOL -> DB: Vector Similarity Search\n(embedding, k=20-30, userKey)
    activate DB
    DB -> DB: Filter by Permissions
    DB -> DB: Cosine Distance Ranking
    DB --> TOOL: Semantic Candidates\n+ Similarity Scores
    deactivate DB
    
    TOOL -> TOOL: BM25 Re-ranking:\n- Build in-memory index\n- Lexical matching\n- Top-8 results
    
    TOOL -> TOOL: Hybrid Scoring:\n- Semantic (60%)\n- BM25 (40%)\n- Final Top-5
    
    TOOL -> TOOL: Context Windowing:\nCombine adjacent chunks
    
    TOOL --> LLM: ToolMessage:\nDocumentation Chunks\n+ Source Metadata
    deactivate TOOL
    
    LLM -> LLM: Reason with\nretrieved context
    
    opt Multiple Retrieval Rounds
        LLM -> TOOL: Invoke again with\nrefined query
        note right: Agent can iterate\nretrieval based on\nintermediate reasoning
    end
end

LLM -> LLM: Generate Final Response\nwith Source Citations

LLM --> BL: AIMessage:\nResponse + Tool Artifacts
deactivate LLM

BL -> BL: Extract Sources\nfrom ToolMessage artifacts

BL -> DB: Save Chat History:\n- SystemMessage\n- HumanMessage\n- ToolMessage(s)\n- AIMessage
activate DB
DB --> BL: Message IDs
deactivate DB

BL --> API: Response + Sources\n+ Message ID
deactivate BL

API --> UI: JSON Response
deactivate API

UI -> UI: Render Markdown
UI -> UI: Display Source Links
UI --> User: AI Response with Sources
deactivate UI

@enduml
