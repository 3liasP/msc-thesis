@article{CuiPeng2019ASoN,
  title = {A Survey on Network Embedding},
  author = {Cui, Peng and Wang, Xiao and Pei, Jian and Zhu, Wenwu},
  date = {2019},
  journaltitle = {IEEE transactions on knowledge and data engineering},
  volume = {31},
  number = {5},
