@article{essamDecodingQueriesInDepth2024,
  title = {Decoding {{Queries}}: {{An In-Depth Survey}} of {{Quality Techniques}} for {{Question Analysis}} in {{Arabic Question Answering Systems}}},
  shorttitle = {Decoding {{Queries}}},
  author = {Essam, Mariam and Deif, Mohanad A. and Attar, Hani and Alrosan, Ayat and Kanan, Mohammad A. and Elgohary, Rania},
  date = {2024},
  journaltitle = {IEEE Access},
  volume = {12},
