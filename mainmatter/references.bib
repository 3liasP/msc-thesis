@online{borseInvestigationInterRaterReliability2025,
  title = {Investigation of the {{Inter-Rater Reliability}} between {{Large Language Models}} and {{Human Raters}} in {{Qualitative Analysis}}},
  author = {Borse, Nikhil Sanjay and Subramaniam, Ravishankar Chatta and Rebello, N. Sanjay},
  date = {2025-08-31},
  eprint = {2508.14764},
  eprinttype = {arXiv},
  eprintclass = {physics},
  doi = {10.48550/arXiv.2508.14764},
  url = {http://arxiv.org/abs/2508.14764},
  urldate = {2025-12-09},
  abstract = {Qualitative analysis is typically limited to small datasets because it is time-intensive. Moreover, a second human rater is required to ensure reliable findings. Artificial intelligence tools may replace human raters if we demonstrate high reliability compared to human ratings. We investigated the inter-rater reliability of state-of-the-art Large Language Models (LLMs), ChatGPT-4o and ChatGPT-4.5-preview, in rating audio transcripts coded manually. We explored prompts and hyperparameters to optimize model performance. The participants were 14 undergraduate student groups from a university in the midwestern United States who discussed problem-solving strategies for a project. We prompted an LLM to replicate manual coding, and calculated Cohen's Kappa for inter-rater reliability. After optimizing model hyperparameters and prompts, the results showed substantial agreement (\$κ{$>$}0.6\$) for three themes and moderate agreement on one. Our findings demonstrate the potential of GPT-4o and GPT-4.5 for efficient, scalable qualitative analysis in physics education and identify their limitations in rating domain-general constructs.},
  pubstate = {prepublished},
  keywords = {Physics - Physics Education},
  file = {/home/elias/Zotero/storage/WCIXLXXJ/Borse et al. - 2025 - Investigation of the Inter-Rater Reliability between Large Language Models and Human Raters in Quali.pdf;/home/elias/Zotero/storage/GI9ASJWR/2508.html}
}

