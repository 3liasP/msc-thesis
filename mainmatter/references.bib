  keywords = {AI for structured manuals,domain adaptation,LoRA-based fine-tuning,multimodal RAG,question-answering system,technical documentation},
  file = {/home/elias/Zotero/storage/J7UEGFFG/Nam et al. - 2025 - LoRA-Tuned Multimodal RAG System for Technical Manual QA A Case Study on Hyundai Staria.pdf}
